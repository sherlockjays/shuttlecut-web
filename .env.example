# docker-compose.yml이 ${VAR} 형태로 참조하는 값들입니다.
# 방식 A(전체 스택)와 방식 B-2(postgres/redis도 컨테이너로) 둘 다 이 파일이 필요합니다.
# 네이티브로 띄운 백엔드는 이 파일이 아니라 backend/.env를 읽습니다.
#
# ⚠️ 값은 전부 로컬 전용으로 채웁니다. NAS 운영 값을 여기에 넣지 마세요.
#    컨테이너가 운영 DB를 가리키게 되어 격리가 깨집니다.
#
# backend/.env와 이름이 같은 키가 여럿 있지만 값을 맞출 필요는 없습니다.
# 백엔드는 한 번에 한 곳에서만 설정을 받습니다. 컨테이너로 뜨면 이 파일에서,
# 네이티브로 뜨면 backend/.env에서 받습니다. 아래 change-me 를 그대로 둬도 방식 A는 동작합니다.
#
# backend.environment에 나열된 키만 백엔드 컨테이너로 들어갑니다. 여기에 값이
# 있어도 그 목록에 줄이 없으면 백엔드는 받지 못하므로 두 곳을 함께 고쳐야 합니다.

# ── 이미지 태그 ──
# docker-compose.yml의 image:가 이 값을 씁니다. 로컬은 dev 고정으로 충분합니다.
# NAS에서는 배포하는 커밋의 SHA가 들어갑니다. 배포 절차가 git에서 읽어 채우므로
# 손으로 적지 않습니다. 롤백은 이 값을 옛 SHA로 바꾸고 up -d --no-build 하면 끝입니다.
IMAGE_TAG=dev

# ── 인프라 연결 ──
DATABASE_URL=postgresql://shuttlecut:password@postgres:5432/shuttlecut
REDIS_URL=redis://:yourpassword@redis:6379/0
STORAGE_PATH=/data/videos

# ── JWT 서명 + YouTube refresh_token 암호화 ──
# core/crypto.py가 이 값에서 암호화 키를 파생합니다.
# 바꾸면 이미 저장된 YouTube 토큰을 복호화할 수 없습니다.
SECRET_KEY=change-me

# ── 워커 <-> 백엔드 내부 API 인증 (api/routes/internal.py) ──
# 워커 PC의 .env.native-worker와 값이 같아야 합니다.
# 다르면 워커 요청이 전부 403이 되어 내보내기가 전면 중단됩니다.
WORKER_SECRET=change-me

# ── Google OAuth ──
# 로그인(api/routes/auth.py)과 유튜브 업로드(api/routes/youtube.py)가 함께 씁니다.
# APP_BASE_URL은 Google에 넘길 콜백 절대 URL을 조립하는 데 쓰이므로
# 브라우저가 실제로 접속하는 주소여야 합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000

# ── 이메일 발송 (core/email.py) ──
# 인증 메일과 비밀번호 재설정 메일. 비워두면 발송 없이 콘솔 로그만 남습니다.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ── postgres/redis 컨테이너 기동용 ──
# 백엔드로는 주입되지 않습니다. 위 DATABASE_URL / REDIS_URL 안에 같은
# 비밀번호가 들어가므로 값을 맞춰야 합니다.
POSTGRES_DB=shuttlecut
POSTGRES_USER=shuttlecut
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
