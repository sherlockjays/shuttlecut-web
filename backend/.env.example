# 백엔드를 네이티브로 띄울 때 읽는 파일입니다 (main.py의 load_dotenv).
# 전체 스택을 docker compose로 띄우는 방식 A에서는 이 파일이 아니라 루트 .env가 쓰입니다.

# ── DB / Redis ── 둘 중 하나를 고릅니다
# B-1) NAS의 운영 DB/Redis를 그대로 사용. 실데이터이므로 스키마 변경·삭제 금지
#DATABASE_URL=postgresql://<NAS_DB_USER>:<PW>@<NAS_IP>:15432/shuttlecut
#REDIS_URL=redis://:<PW>@<NAS_IP>:6379/0
# B-2) 로컬 컨테이너 사용. docker compose up -d postgres redis 로 먼저 띄웁니다
#      (그러려면 루트 .env가 필요합니다. 비밀번호는 루트 .env의 값과 맞춰야 합니다)
DATABASE_URL=postgresql://shuttlecut:password@localhost:15432/shuttlecut
REDIS_URL=redis://:password@localhost:6379/0

# 내보내기 원본·결과물을 두는 경로. 네이티브 실행이라 윈도우 경로입니다
STORAGE_PATH=C:/tmp/shuttlecut-storage

# JWT 서명 + YouTube refresh_token 암호화 (core/crypto.py가 이 값에서 키를 파생)
# ⚠️ B-1처럼 NAS 운영 DB에 붙을 때는 NAS와 같은 값이어야 합니다. 다르면 이미 저장된
#    YouTube 토큰을 복호화하지 못하고, 로컬에서 연결한 토큰도 운영이 읽지 못합니다
SECRET_KEY=your-secret-key-here-change-in-production

# 워커 <-> 백엔드 내부 API 인증 (api/routes/internal.py). 비어있으면 워커 요청이 전부 403으로 거부됨
# 워커를 함께 돌릴 때는 .env.native-worker의 값과 같아야 합니다
WORKER_SECRET=your-worker-secret-here

# Google OAuth2 로그인 (api/routes/auth.py) + 유튜브 업로드 (api/routes/youtube.py)
# APP_BASE_URL은 Google에 넘길 콜백 절대 URL을 조립하는 데 쓰이므로,
# 브라우저가 실제로 SPA를 여는 주소여야 합니다
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 이메일 발송 (core/email.py)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
