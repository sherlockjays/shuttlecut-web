# 백엔드를 네이티브로 띄울 때 읽는 파일입니다 (main.py의 load_dotenv).
# 전체 스택을 docker compose로 띄우는 방식 A에서는 이 파일이 아니라 루트 .env가 쓰입니다.
#
# ── 필수와 선택 ──
# 아래 "필수" 표시가 붙은 키는 비어 있으면 백엔드가 기동하지 않습니다. 잘못된 값으로
# 조용히 도는 것보다 안 뜨는 쪽이 낫기 때문입니다 (core/config.py의 require_env).
# 선택값은 비워둬도 됩니다. 비면 해당 기능만 꺼집니다.

# ── DB / Redis ── (필수) 둘 중 하나를 고릅니다
# B-1) NAS의 운영 DB/Redis를 그대로 사용. 실데이터이므로 스키마 변경·삭제 금지
#DATABASE_URL=postgresql://<NAS_DB_USER>:<PW>@<NAS_IP>:15432/shuttlecut
#REDIS_URL=redis://:<PW>@<NAS_IP>:6379/0
# B-2) 로컬 컨테이너 사용. docker compose up -d postgres redis 로 먼저 띄웁니다
#      (그러려면 루트 .env가 필요합니다. 비밀번호는 루트 .env의 값과 맞춰야 합니다)
DATABASE_URL=postgresql://shuttlecut:password@localhost:15432/shuttlecut
REDIS_URL=redis://:password@localhost:6379/0

# (필수) 내보내기 원본·결과물을 두는 경로. 네이티브 실행이라 윈도우 경로입니다
STORAGE_PATH=C:/tmp/shuttlecut-storage

# (필수) JWT 서명 + YouTube refresh_token 암호화 (core/crypto.py가 이 값에서 키를 파생)
# ⚠️ B-1처럼 NAS 운영 DB에 붙을 때는 NAS와 같은 값이어야 합니다. 다르면 이미 저장된
#    YouTube 토큰을 복호화하지 못하고, 로컬에서 연결한 토큰도 운영이 읽지 못합니다
SECRET_KEY=your-secret-key-here-change-in-production

# (필수) 워커 <-> 백엔드 내부 API 인증 (api/routes/internal.py)
# 워커를 함께 돌릴 때는 .env.native-worker의 값과 같아야 합니다. 다르면 워커 요청이 전부 403입니다
WORKER_SECRET=your-worker-secret-here

# (필수) Google에 넘길 콜백 절대 URL을 조립하는 데 쓰이므로,
# 브라우저가 실제로 SPA를 여는 주소여야 합니다. 끝에 / 를 붙이지 않습니다
APP_BASE_URL=http://localhost:5173

# (선택) Google OAuth2 로그인 (api/routes/auth.py) + 유튜브 업로드 (api/routes/youtube.py)
# 둘 중 하나라도 비면 해당 기능이 503을 냅니다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (선택) 이메일 발송 (core/email.py)
# 네 개를 다 채워야 발송되고, 하나라도 비면 발송 없이 콘솔 로그만 남습니다
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
