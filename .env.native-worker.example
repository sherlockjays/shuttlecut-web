# 네이티브 워커 환경변수 템플릿
#
# 이 파일을 .env.native-worker 로 복사해서 값을 채운다. 사본은 gitignore 대상이다.
# 워커 전용 체크아웃의 루트에 둔다. 이 파일이 있는 체크아웃이 곧 "워커 체크아웃"이고,
# start-native-worker.ps1 과 scripts/deploy-worker.ps1 이 그것으로 판별한다.
#
# 값은 NAS 백엔드와 맞춰야 한다. 어긋나면 내보내기가 통째로 실패한다.

# NAS의 PostgreSQL. 워커가 프로젝트와 내보내기 상태를 직접 읽고 쓴다
DATABASE_URL=postgresql://<사용자>:<비밀번호>@<NAS_IP>:15432/shuttlecut

# NAS의 Redis. 여기서 내보내기 작업을 받아간다
REDIS_URL=redis://:<비밀번호>@<NAS_IP>:6379/0

# 워커가 인코딩 중에 쓰는 로컬 임시 디렉터리. 결과물은 NAS로 업로드한 뒤 지워진다
STORAGE_PATH=C:/tmp/shuttlecut

# 원본을 받고 결과물을 올릴 NAS 백엔드 주소.
# localhost가 아니다. 워커와 NAS는 다른 기계이고 파일시스템을 공유하지 않는다
NAS_BACKEND_URL=http://<NAS_IP>:8000

# /api/internal/* 인증용. NAS 백엔드의 WORKER_SECRET과 같은 값이어야 한다.
# 어긋나면 워커 요청이 전부 403이 되어 내보내기가 전면 중단된다
WORKER_SECRET=<NAS와 같은 값>

# GPU 가속. GPU가 없으면 ENABLE_GPU=0
ENABLE_GPU=1
ENABLE_OPENCL=1
ENABLE_NVDEC=1

# 이 파일 말고도 backend/fonts/NanumGothicBold.ttf 가 필요하다.
# gitignore 대상이라 클론에 따라오지 않는다. 없으면 점수판 오버레이의 한글이 깨진다.
# NAS 백엔드 이미지는 apt로 fonts-nanum을 깔지만 윈도우에는 그 경로가 없다.
